\@writefile{lof}{\contentsline {figure}{\numberline {9.5}{\ignorespaces Hashing the integers $0,1,2,3$, and 4 into an $n=8$ bit Bloom filter, using hash functions $h_{1}(x)=2 x+1$ (blue) and $h_{2}(x)=3 x+2$ (red). Searching for $x=5$ would yield a false positive, since the two corresponding bits have been set by other elements.\\}}{201}{figure.9.5}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {9.6}{\ignorespaces Bloom filter error probability as a function of load $(m / n)$ for $k$ from 1 to 5 . By selecting the right $k$ for the given load, we can dramatically reduce false positive error rate with no increase in table space.\\}}{203}{figure.9.6}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {9.7}{\ignorespaces The probability of no collisions in a hash table decreases rapidly with $n$, the number of keys to hash. Here the hash table size is $m=365$.\\}}{204}{figure.9.7}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {9.8}{\ignorespaces Perfect hashing uses a two-level hash table to guarantee lookup in constant time. The first-level table encodes an index range of $l_{i}{ }^{2}$ elements in the second-level table, allocated to store the $l_{i}$ items in first-level bucket $i$.\\}}{205}{figure.9.8}\protected@file@percent }
