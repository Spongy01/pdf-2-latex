\@writefile{lof}{\contentsline {figure}{\numberline {3.20}{\ignorespaces \xpg@aux {}{english}Figure 5.16: Permutation tests score significance by the position of the score on actual data against a distribution of scores produced by random permutations. A position on the extreme tail (left) is highly significant, but one within the body of the distribution (left) is uninteresting.}}{204}{figure.3.20}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3.21}{\ignorespaces \xpg@aux {}{english}The generation frequency of all $4!=24$ permutations using two different algorithms. Algorithm 1 generates them with uniform frequency, while algorithm 2 is substantially biased.}}{205}{figure.3.21}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3.22}{\ignorespaces \xpg@aux {}{english}The distribution of longest hitting streaks, over 100,000 simulated careers. DiMaggio's actual 56-game hitting streak stands at the very tail of this distribution, thus demonstrating the difficulty of this feat.}}{205}{figure.3.22}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3.23}{\ignorespaces \xpg@aux {}{english}Figure 6.1: The array of dot plots of variable pairs provides quick insight into the distributions of data values and their correlations.}}{206}{figure.3.23}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3.24}{\ignorespaces \xpg@aux {}{english}Figure 6.3: Plots of the Ascombe quartet. These data sets are all dramatically different, even though they have identical summary statistics.}}{207}{figure.3.24}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3.25}{\ignorespaces \xpg@aux {}{english}Which painting do you like better? Forming intelligent preferences in art or visualizations depend upon having a distinctive visual aesthetic.}}{207}{figure.3.25}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3.26}{\ignorespaces \xpg@aux {}{english}Three-dimensional monoliths casting rendered shadows (l) may look impressive. But they really are just chartjunk, which serves to reduce the clarity and data-ink ratio from just showing the data (r).}}{208}{figure.3.26}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3.27}{\ignorespaces \xpg@aux {}{english}Three renderings of the same financial time series. Which most accurately represents the situation?}}{208}{figure.3.27}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3.28}{\ignorespaces \xpg@aux {}{english}A monthly time series of sales. How can we improve/simplify this bar chart time series?}}{209}{figure.3.28}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3.29}{\ignorespaces \xpg@aux {}{english}Four successive simplifications of Figure 6.7 by removing extraneous non-data elements.}}{209}{figure.3.29}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3.30}{\ignorespaces \xpg@aux {}{english}Scaling over the maximum possible range (left) is silly when all it shows is white space. Better scaling permits more meaningful comparisons (right).}}{210}{figure.3.30}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3.31}{\ignorespaces \xpg@aux {}{english}Color scales from Python's MatPlotLib, varying hue, saturation, and brightness. Rainbow color maps are perceptually non-linear, making it difficult to recognize the magnitudes of differences.}}{210}{figure.3.31}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3.32}{\ignorespaces \xpg@aux {}{english}A clever decision tree to help identify the best visual representation for representing data. Reprinted with permission from Abela [Abe13].}}{211}{figure.3.32}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3.33}{\ignorespaces \xpg@aux {}{english}Many of the line chart styles that we have seen are supported by Python's MatPlotLib package.}}{212}{figure.3.33}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3.34}{\ignorespaces \xpg@aux {}{english}Figure 6.13: Box and whisker plots concisely show the range/quartiles (i.e. median and variance) of a distribution. (hairs) are added to show the range of the highest and lowest values. Figure 6.13 shows a box-and-whisker plot of weight as a function of height in a population sample. The median weight increases with height, but not the maximum, because fewer points in the tallest bucket reduces the chance for an outlier maximum value.}}{213}{figure.3.34}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3.35}{\ignorespaces \xpg@aux {}{english}Figure 6.14: Smaller dots on scatter plots (left) reveal more detail than the default dot size (right).}}{213}{figure.3.35}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3.36}{\ignorespaces \xpg@aux {}{english}Overlapping dots can obscure scatter plots, particularly for large data sets. Reducing the opacity of the dots (left) shows some of the fine structure of the data (left). But a colored heatmap more dramatically reveals the distribution of the points (right).}}{214}{figure.3.36}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3.37}{\ignorespaces \xpg@aux {}{english}Adding size and color to a scatter plot leads to natural fourdimensional visualizations, here illustrating properties of the world's nations. Based on a free chart from \href  {http://www.gapminder.org}{http://www.gapminder.org}}}{215}{figure.3.37}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3.38}{\ignorespaces \xpg@aux {}{english}Voter data from three U.S. presidential elections. Bar plots and pie charts display the frequency of proportion of categorical variables. Relative magnitudes in a time series can be displayed by modulating the area of the line or circle.}}{216}{figure.3.38}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3.39}{\ignorespaces \xpg@aux {}{english}Small multiple bar plots/tables are excellent ways to represent multivariate data for comparison.}}{216}{figure.3.39}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3.40}{\ignorespaces \xpg@aux {}{english}Stacked bar charts illustrating the survivorship rate on the doomed ship \textit  {Titanic}, by ticket class. The histogram (left) informs us of the size of each class, but scaled bars (right) better capture proportions. Primary conclusion: you were better off not to be traveling steerage (third class).}}{217}{figure.3.40}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3.41}{\ignorespaces \xpg@aux {}{english}Pie charts of delegates to the 2016 Republican convention by candidate. Which one is better and why?}}{217}{figure.3.41}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3.42}{\ignorespaces \xpg@aux {}{english}Time series of vote totals in U.S. presidential elections by party enable us to see the changes in magnitude and distribution. Democrats are shown in blue, and Republicans in red. It is hard to visualize changes, particularly in the middle layers of the stack.}}{218}{figure.3.42}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3.43}{\ignorespaces \xpg@aux {}{english}Histograms of a given distribution can look wildly different depending on the number of bins. A large data set benefits from many bins (top). But the structure of a smaller data set is best shown when each bin a non-trivial number of element.}}{218}{figure.3.43}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3.44}{\ignorespaces \xpg@aux {}{english}Dividing counts by the total yields a probability density plot, which is more generally interpretable even though the shapes are identical.}}{219}{figure.3.44}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3.45}{\ignorespaces \xpg@aux {}{english}Generally speaking, histograms are better for displaying peaks in a distribution, but cdfs are better for showing tails.}}{219}{figure.3.45}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3.46}{\ignorespaces \xpg@aux {}{english}Maps summarizing the results of the 2012 U.S. presidential election. The recipient of each state's electoral votes is effectively presented on a data map (left), while a cartogram making the area of each state proportional to the number of votes (right) better captures the magnitude of Obama's victory. \textit  {Source}: Images from Wikipedia.}}{220}{figure.3.46}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3.47}{\ignorespaces \xpg@aux {}{english}Marey's train schedule plots the position of each train as a function of time.}}{221}{figure.3.47}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3.48}{\ignorespaces \xpg@aux {}{english}Cholera deaths center around a pump on Broad street, revealing the source of the epidemic.}}{222}{figure.3.48}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3.49}{\ignorespaces \xpg@aux {}{english}This weather year in review displays a clear story in over 2000 numbers.}}{223}{figure.3.49}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3.50}{\ignorespaces \xpg@aux {}{english}A dotplot of word frequency by rank. What do you see?}}{223}{figure.3.50}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3.51}{\ignorespaces \xpg@aux {}{english}Frequency of 10,000 English words. Plotting the word frequencies on a $\log $ scale (left), or even better on a log-log scale reveals that it is power law (right).}}{224}{figure.3.51}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3.52}{\ignorespaces \xpg@aux {}{english}Folding energy of genes as a function of their length. Mistaking variance for signal: the extreme values in the left figure are artifacts from averaging small numbers of samples.}}{224}{figure.3.52}\protected@file@percent }
